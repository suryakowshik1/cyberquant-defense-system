# ==============================================================================
# CyberQuant AI - Enterprise Defensive Cybersecurity Platform
# Environment Configuration Template (.env.example)
# Note: Copy this file to .env and configure your production credentials.
# NEVER commit the actual .env file to public version control.
# ==============================================================================

# Application Security Secret (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_64_character_hex_secret

# Deployment Environment ('production' or 'development')
ENVIRONMENT=production

# SIH Demonstration Sandbox Mode ('true' enables presentation demo login, 'false' requires strict production auth)
DEMO_MODE=true

# Cross-Origin Resource Sharing (CORS) Whitelist (comma-separated origins)
CORS_ORIGINS=https://cyberquant-defense-system.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# Canonical Application Base URL (used in email reset links)
APP_URL=https://cyberquant-defense-system.vercel.app

# SMTP Multi-Factor Authentication & Email Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cyberquant26@gmail.com
SMTP_PASS=your_16_character_app_password_here
SMTP_FROM=CyberQuant SOC Defense <cyberquant26@gmail.com>
